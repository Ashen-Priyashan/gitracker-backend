DB_URL=jdbc:postgresql://localhost:5435/gitracker
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Redis & Caching (none or redis)
CACHE_TYPE=none
REDIS_HOST=localhost
REDIS_PORT=6379

# GitHub API
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_TOKEN=your_github_personal_access_token
GITHUB_API_CONNECT_TIMEOUT_SECONDS=5
GITHUB_API_READ_TIMEOUT_SECONDS=10

# GitHub App Configuration
GITHUB_APP_ID=your_github_app_id
GITHUB_CLIENT_ID=your_github_app_client_id
GITHUB_CLIENT_SECRET=your_github_app_client_secret
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_REDIRECT_URI=http://localhost:8080/api/github/callback

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Security & Token Encryption (AES-256-GCM 32-character or base64 secret)
ENCRYPTION_SECRET_KEY=your_secure_32_character_encryption_key_here!
